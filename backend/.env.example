APP_NAME="IBE Reality"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://app-erp.ibereality.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Project attachments - Cloudflare R2 (required on VPS production)
PROJECT_ATTACHMENTS_REQUIRE_R2=false
HARDWARE_PUSH_REQUIRE_SIGNATURE=true
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Optional public/custom domain. Leave empty to use authenticated backend streaming.
R2_PUBLIC_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_ENCRYPTION=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS="noreply@ibereality.com"
MAIL_FROM_NAME="${APP_NAME}"
PDF_MEMORY_LIMIT=256M
PDF_IMAGE_MAX_BYTES=3145728
PDF_IMAGE_MAX_PIXELS=6000000

# ── Google Drive (task attachments) ──────────────────────────────────────────
# Path RELATIVE to backend root. Place the service account JSON file here.
# Get it from: Google Cloud Console → IAM → Service Accounts → Keys
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=storage/app/google-credentials.json
# Optional: target folder ID (share this folder with the service account email)
GOOGLE_DRIVE_FOLDER_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend domain (used for CORS — space-separated if multiple)
FRONTEND_URL=https://attendance.ibereality.com

# Human face engine
# Face engine driver: 'human' (self-hosted, template stays in our DB) or
# 'biznet' (Biznet Face API, enrollment-based). Production must stay on 'human':
# the Biznet driver enrolls at registration time, ahead of the admin approval
# gate, and sends biometrics to a third party. Demo compose only.
FACE_ENGINE_DRIVER=human
FACE_ENGINE_URL=http://127.0.0.1:3899
FACE_ENGINE_TIMEOUT=20
FACE_MATCH_SIMILARITY_THRESHOLD=0.60
FACE_ENGINE_MAX_IMAGE_SIDE=320

# Biznet Face API — demo only. Never commit the real token; inject it through
# the demo compose environment.
FACE_BIZNET_URL=https://fr.neoapi.id/risetai/face-api
FACE_BIZNET_TOKEN=
FACE_BIZNET_FACEGALLERY_ID=
FACE_BIZNET_TIMEOUT=20

HOLIDAY_API_ENABLED=true
HOLIDAY_API_TIMEOUT=8

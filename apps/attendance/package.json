{
  "name": "ibe-attendance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:fonts": "node ./scripts/copy-local-font-evidence.mjs",
    "prepare:models": "node ./scripts/copy-face-model-evidence.mjs",
    "prepare:assets": "npm run prepare:fonts && npm run prepare:models",
    "predev": "npm run prepare:assets",
    "dev": "vite",
    "prebuild": "npm run prepare:assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "verify:bundle": "node ./scripts/verify-production-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/rubik": "5.3.0",
    "@popperjs/core": "^2.11.8",
    "@tanstack/react-query": "^5.99.0",
    "@vladmandic/face-api": "1.7.15",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.8",
    "html-to-image": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion": "1.1.18",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
